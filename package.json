{
  "name": "veydrift",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web",
    "typecheck": "npm run typecheck --workspace=apps/web",
    "run:cycle": "tsx packages/agent/src/runner.ts",
    "cycle:dry": "tsx packages/agent/src/runner.ts --dry-run",
    "start": "node server.js",
    "railway:start": "node server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@x402/axios": "^2.15.0",
    "@x402/evm": "^2.15.0",
    "axios": "^1.17.0",
    "dotenv": "^17.0.0",
    "ethers": "^6.16.0",
    "viem": "^2.52.2"
  },
  "devDependencies": {
    "tsx": "^4.22.4",
    "typescript": "^5.6.0"
  }
}

